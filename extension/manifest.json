{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.2",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.bilibili.com/*",
    "*://*.douyin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.bilibili.com/*",
        "*://*.douyin.com/*"
      ],
      "js": ["content/bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "1-toggle-pip": {
      "suggested_key": {
        "default": "Alt+W",
        "mac": "Alt+W"
      },
      "description": "__MSG_cmdTogglePip__"
    },
    "2-seek-back": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "__MSG_cmdSeekBack__"
    },
    "3-toggle-play": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "__MSG_cmdTogglePlay__"
    },
    "4-seek-forward": {
      "description": "__MSG_cmdSeekForward__"
    },
    "5-next-video": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "__MSG_cmdNextVideo__"
    }
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html"
  }
}
